---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = [...new Set(posts.map((p) => p.data.category))];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>罪悪感ゼロ介護 お悩み相談</title>
    <meta
      name="description"
      content="施設入所、自分の時間を優先すること——介護のなかで生まれる罪悪感に、介護福祉士・社会福祉士の視点から寄り添うお悩み相談サイトです。"
    />
  </head>
  <body>
    <div class="page">
      <header>
        <h1>罪悪感ゼロ介護</h1>
        <p class="lead">
          「施設に入れるなんて親不孝じゃないか」「自分の時間を優先していいのか」——介護のなかで生まれるその罪悪感は、あなたが真剣に向き合ってきた証です。同じ悩みを抱える方の質問形式で、専門家の視点からの考え方と頼れる相談先を紹介しています。
        </p>
      </header>

      <main>
        {
          categories.length === 0 && (
            <p class="empty">現在準備中です。近日公開予定です。</p>
          )
        }
        {
          categories.map((category) => (
            <section class="category">
              <h2>{category}</h2>
              <ul class="qa-list">
                {posts
                  .filter((post) => post.data.category === category)
                  .map((post) => (
                    <li>
                      <a class="qa-card" href={`/qa/${post.slug}/`}>
                        <span class="q">Q. {post.data.keyword}</span>
                        <span class="desc">{post.data.description}</span>
                        <span class="cta">回答を見る →</span>
                      </a>
                    </li>
                  ))}
              </ul>
            </section>
          ))
        }
      </main>
    </div>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
  }

  .page {
    max-width: 780px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
    font-family: system-ui, sans-serif;
    color: #3d3527;
    background: #fffdf8;
    line-height: 1.8;
  }

  header h1 {
    font-size: 1.9rem;
    margin-bottom: 0.75rem;
  }

  .lead {
    color: #5c5344;
    font-size: 0.98rem;
  }

  .category {
    margin-top: 2.5rem;
  }

  .category h2 {
    font-size: 1.15rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid #e8dcc4;
    color: #9c6530;
  }

  .qa-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .qa-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border: 1px solid #e8dcc4;
    border-radius: 0.75rem;
    background: #fff;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .qa-card:hover {
    border-color: #d9a35f;
  }

  .q {
    font-weight: 700;
    color: #3d3527;
  }

  .desc {
    font-size: 0.9rem;
    color: #6b6152;
  }

  .cta {
    align-self: flex-end;
    font-size: 0.85rem;
    color: #b5793c;
    font-weight: 600;
  }

  .empty {
    color: #6b6152;
  }
</style>
