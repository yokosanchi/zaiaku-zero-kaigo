---
import { getCollection } from "astro:content";
import CareAffiliateBanner from "../../components/CareAffiliateBanner.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title}</title>
    <meta name="description" content={post.data.description} />
  </head>
  <body>
    <div class="page">
      <a class="back-link" href="/">← お悩み一覧に戻る</a>
      <p class="question-label">Q. {post.data.keyword}</p>
      <main>
        <article>
          <Content />
        </article>
        <CareAffiliateBanner conversionType={post.data.conversion_type} />
      </main>
    </div>
  </body>
</html>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
    font-family: system-ui, sans-serif;
    color: #3d3527;
    line-height: 1.9;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: #9c6530;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .question-label {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    margin-bottom: 1.5rem;
    border-radius: 999px;
    background: #fdf1df;
    color: #9c6530;
    font-weight: 700;
    font-size: 0.9rem;
  }

  article :global(h1) {
    font-size: 1.6rem;
    line-height: 1.5;
  }

  article :global(h2) {
    margin-top: 2rem;
    font-size: 1.2rem;
    border-left: 4px solid #d9a35f;
    padding-left: 0.6rem;
  }
</style>
