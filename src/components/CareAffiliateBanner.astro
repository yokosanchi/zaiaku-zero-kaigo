---
// アフィリエイト枠。ENABLE_AFFILIATE=='true' の場合のみ表示する。
// トラフィック蓄積期（公開後1〜3ヶ月目など）は環境変数を 'false' にすることで
// サイト全体の広告表示をコードの変更なしに一括OFFにできる。
export interface Props {
  conversionType: string;
}

const { conversionType } = Astro.props;

// Vite coerces "true"/"false"-looking env values to real booleans when
// injecting import.meta.env at build time (observed even though shell env
// vars are always strings), so a strict === "true" check silently never
// matches. Accept both the boolean and the string form.
const enableAffiliateEnv = import.meta.env.ENABLE_AFFILIATE;
const isEnabled = enableAffiliateEnv === true || enableAffiliateEnv === "true";

type OfferContent = {
  heading: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  sponsored?: boolean;
  trackingPixelSrc?: string;
};

const OFFERS: Record<string, OfferContent> = {
  施設検索: {
    heading: "入所できる施設を無料で探す",
    body: "希望条件に合う介護施設を専門相談員が無料でご案内します。空き状況の確認や見学の同行手配も可能です。",
    ctaLabel: "施設を無料で探してみる",
    ctaHref: "#facility-search",
  },
  資料請求: {
    heading: "関連サービスの資料を無料請求",
    body: "気になったサービスの詳しい資料を、まとめて無料でお取り寄せいただけます。比較検討にお役立てください。",
    ctaLabel: "無料で資料をもらう",
    ctaHref: "#document-request",
  },
  訪問介護マッチング: {
    heading: "介護保険では対応できない部分も、プロに頼れます",
    body: "24時間365日対応、オーダーメイドの介護保険外サービス「イチロウ」。時間や回数の制約なく、あなたやご家族に合った形で介護のプロに任せられます。（対応エリア：東京都・神奈川県・千葉県・埼玉県・愛知県の一部）",
    ctaLabel: "イチロウの詳細を見る",
    ctaHref: "https://px.a8.net/svt/ejp?a8mat=4BCH7Q+2LH4AQ+54PG+5YRHE",
    sponsored: true,
    trackingPixelSrc: "https://www13.a8.net/0.gif?a8mat=4BCH7Q+2LH4AQ+54PG+5YRHE",
  },
};

const DEFAULT_OFFER: OfferContent = {
  heading: "介護の相談窓口を探す",
  body: "お一人で抱え込まず、まずは無料で相談できる窓口をご案内します。",
  ctaLabel: "相談窓口を見てみる",
  ctaHref: "#care-consultation",
};

const offer = OFFERS[conversionType] ?? DEFAULT_OFFER;
---

{
  isEnabled && (
    <aside class="care-affiliate-banner" data-conversion-type={conversionType}>
      {offer.sponsored && <span class="care-affiliate-banner__pr">PR</span>}
      <p class="care-affiliate-banner__heading">{offer.heading}</p>
      <p class="care-affiliate-banner__body">{offer.body}</p>
      <a
        class="care-affiliate-banner__cta"
        href={offer.ctaHref}
        {...(offer.sponsored
          ? { target: "_blank", rel: "nofollow sponsored noopener" }
          : {})}
      >
        {offer.ctaLabel}
      </a>
      {offer.trackingPixelSrc && (
        <img
          src={offer.trackingPixelSrc}
          width="1"
          height="1"
          alt=""
          style="border:0; position:absolute;"
        />
      )}
    </aside>
  )
}

<style>
  .care-affiliate-banner {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid #e0d8c8;
    border-radius: 0.75rem;
    background: #fdfaf3;
  }

  .care-affiliate-banner__pr {
    display: inline-block;
    margin-bottom: 0.6rem;
    padding: 0.15rem 0.55rem;
    border-radius: 0.3rem;
    background: #8f5a26;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .care-affiliate-banner__heading {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: 1.05rem;
    color: #4a3f2c;
  }

  .care-affiliate-banner__body {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #5c5344;
  }

  .care-affiliate-banner__cta {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    background: #b5793c;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  .care-affiliate-banner__cta:hover {
    background: #9c6530;
  }
</style>
