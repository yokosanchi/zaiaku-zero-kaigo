# アフィリエイト枠の表示切り替え。トラフィック蓄積期（公開後1〜3ヶ月目）は false にする。
ENABLE_AFFILIATE=false

# scripts/generate_care_article.py が使用する Gemini API キー（無料枠あり。https://aistudio.google.com/apikey で発行。GitHub Actions では Secrets 経由で渡す）
GEMINI_API_KEY=

# 使用するモデル名（省略時は gemini-2.0-flash）
GEMINI_MODEL=gemini-2.0-flash

# scripts/fetch_search_console.py が使う、Google Search Console API用の
# サービスアカウントJSONキー（1行の文字列として）。未設定でもパイプラインは
# 動作するが、実際の検索クエリに基づくキーワード補充は行われなくなる。
GSC_SERVICE_ACCOUNT_KEY=

# Search Consoleで確認済みのプロパティURL（末尾の / まで含める）
GSC_SITE_URL=https://zaiaku-zero-kaigo.yokosanchi.workers.dev/

# 任意：Google Analytics 4 の測定ID（GA4 管理 → データストリーム → ウェブ で確認）
# ビルド時に埋め込まれる。未設定ならGAタグは出力されない。`astro dev` 中は常に無効。
# このサイトは Cloudflare の Git連携でビルド・デプロイされるため、
# 本番では Cloudflare ダッシュボード（Workers & Pages → このプロジェクト → Settings → Variables）に
# 同名で登録する（GitHub Actions の Secrets/Variables ではない点に注意）。
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
